---
/**
 * Tabs for showing the same sample for different cloud providers.
 *
 * Usage in MDX:
 *
 *   import CloudTabs from '@components/CloudTabs.astro';
 *
 *   <CloudTabs>
 *   <Fragment slot="aws">
 *
 *   ```hcl
 *   # AWS version
 *   ```
 *
 *   </Fragment>
 *   <Fragment slot="azure">
 *
 *   ```hcl
 *   # Azure version
 *   ```
 *
 *   </Fragment>
 *   </CloudTabs>
 *
 * Every `CloudTabs` on the site shares the `cloud-provider` sync key, so
 * picking a provider in one place switches every other `CloudTabs` on the
 * page at the same time. Starlight persists synced tabs in `localStorage`
 * (keyed by the tab label), so the choice is also remembered across pages
 * and visits. Keep the labels below stable for that reason.
 */
import { Tabs, TabItem } from '@astrojs/starlight/components';
---

<Tabs syncKey="cloud-provider">
	<TabItem label="AWS">
		<slot name="aws" />
	</TabItem>
	<TabItem label="Azure">
		<slot name="azure" />
	</TabItem>
</Tabs>
