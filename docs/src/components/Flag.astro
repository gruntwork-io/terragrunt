---
import DefaultValue from '@components/DefaultValue.astro';
import ReferenceCard from '@components/ReferenceCard.astro';
import TypeBadge from '@components/TypeBadge.astro';
import type { CollectionEntry } from 'astro:content';
import { render, getEntry } from 'astro:content';
import { isPublished } from '@lib/release';

interface Props {
  slug: string;
}

const { slug } = Astro.props;

const flagEntry = await getEntry('flags', slug) as CollectionEntry<'flags'>;
const visible = await isPublished(flagEntry.data.since);
const { Content } = await render(flagEntry);
const { aliases, description, type, env, name, defaultVal } = flagEntry.data;
---

{visible && (
  <section id={name}>
    <ReferenceCard title={"--" + name}>
      <TypeBadge slot="meta" type={type} optional defaultVal={defaultVal} />
      <p id={name}>{description}</p>
      <DefaultValue type={type} value={defaultVal} />
      <Content />
      {aliases && aliases.length > 0 && (
        <>
          <p>Aliases:</p>
          <ul>
            {aliases.map((alias: string) => (
              <li><code dir="auto">{alias}</code></li>
            ))}
          </ul>
        </>
      )}
      {env && (
        <>
          <p>Environment Variables:</p>
          <ul>
            {env.map((envVar: string) => (
              <li><code dir="auto">{envVar}</code></li>
            ))}
          </ul>
        </>
      )}
    </ReferenceCard>
  </section>
)}
