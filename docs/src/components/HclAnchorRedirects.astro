---
/**
 * Redirects old links to a heading on a kind's index page, e.g.
 * `/reference/hcl/functions/#get_env`, to the entry's own page. Render it once
 * on the index page, ahead of any heading.
 */
import AnchorRedirects from '@components/AnchorRedirects.astro';
import { hclItemPath, type HclKind } from '@lib/hcl';
import { getPublishedHclItems } from '@lib/hcl/published';

interface Props {
	kind: HclKind;
}

const { kind } = Astro.props;
const entries = await getPublishedHclItems(kind);

const redirects = Object.fromEntries(entries.map((entry) => [entry.data.name, hclItemPath(kind, entry.data.name)]));
---

<AnchorRedirects redirects={redirects} />
