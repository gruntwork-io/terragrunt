---
import { Badge } from '@astrojs/starlight/components';
import type { HclConfig } from '@lib/hcl';

interface Props {
	configs: HclConfig[];
}

const { configs } = Astro.props;
---

<div class="configs">
	{configs.map((config) => <Badge text={config} variant="note" size="medium" style={{ fontWeight: 'bold' }} />)}
	<slot />
</div>

<style>
	.configs {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
	}
</style>
