---
import { Code } from '@astrojs/starlight/components';
import { render, type CollectionEntry } from 'astro:content';
import HclConfigs from '@components/HclConfigs.astro';
import HclExamples from '@components/HclExamples.astro';
import ReferenceCard from '@components/ReferenceCard.astro';
import TypeBadge from '@components/TypeBadge.astro';
import { functionSignature } from '@lib/hcl';
import { renderMarkdownField } from '@lib/hcl/markdown';

interface Props {
	entry: CollectionEntry<'hclFunctions'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const params = await Promise.all(
	entry.data.params.map(async (param) => ({
		...param,
		html: await renderMarkdownField(param.description),
	})),
);
---

<HclConfigs configs={entry.data.configs} />

<h2 id="usage">Usage</h2>

<Code code={functionSignature(entry.data)} lang="hcl" />

<Content />

{
	params.length > 0 && (
		<>
			<h2 id="parameters">Parameters</h2>
			{params.map((param) => (
				<ReferenceCard title={param.name}>
					<TypeBadge slot="meta" type={param.type} optional={param.optional} />
					<Fragment set:html={param.html} />
				</ReferenceCard>
			))}
		</>
	)
}

<HclExamples examples={entry.data.examples} />
