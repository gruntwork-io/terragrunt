---
/**
 * Lists the published entries of one HCL kind, each linking to its page.
 *
 * Also redirects old links to a heading on the kind's index page, e.g.
 * `/reference/hcl/functions/#get_env`, to the entry's own page. Render it on
 * the index page, ahead of any heading.
 */
import AnchorRedirects from '@components/AnchorRedirects.astro';
import { configLabel, hclItemPath, type HclKind } from '@lib/hcl';
import { getPublishedHclItems } from '@lib/hcl/published';

interface Props {
	kind: HclKind;
}

const { kind } = Astro.props;
const entries = await getPublishedHclItems(kind);

const redirects = Object.fromEntries(entries.map((entry) => [entry.data.name, hclItemPath(kind, entry.data.name)]));
---

<AnchorRedirects redirects={redirects} />

{
	entries.length > 0 && (
		<table>
			<thead>
				<tr>
					<th>Name</th>
					<th>Used in</th>
					<th>Description</th>
				</tr>
			</thead>
			<tbody>
				{entries.map((entry) => (
					<tr>
						<td>
							<a href={hclItemPath(kind, entry.data.name)}>
								<code>{entry.data.name}</code>
							</a>
						</td>
						<td>{entry.data.configs.map(configLabel).join(', ')}</td>
						<td>{entry.data.description}</td>
					</tr>
				))}
			</tbody>
		</table>
	)
}
