---
import { Badge } from '@astrojs/starlight/components';
import { configLabel, type HclConfig } from '@lib/hcl';

interface Props {
	configs: HclConfig[];
}

const { configs } = Astro.props;
---

<div>
	<span>Used in: </span>
	{
		configs.map((config) => (
			<>
				<Badge text={configLabel(config)} variant="note" />{' '}
			</>
		))
	}
</div>
