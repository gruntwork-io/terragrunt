---
import { Code } from '@astrojs/starlight/components';
import { render, type CollectionEntry } from 'astro:content';
import HclConfigs from '@components/HclConfigs.astro';
import HclExamples from '@components/HclExamples.astro';
import ReferenceCard from '@components/ReferenceCard.astro';
import TypeBadge from '@components/TypeBadge.astro';
import { variableAttributeName } from '@lib/hcl';
import { renderMarkdownField } from '@lib/hcl/markdown';

interface Props {
	entry: CollectionEntry<'hclVariables'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const attributes = await Promise.all(
	entry.data.attributes.map(async (attribute) => ({
		...attribute,
		title: variableAttributeName(entry.data.name, attribute),
		html: await renderMarkdownField(attribute.description),
	})),
);
---

<HclConfigs configs={entry.data.configs} />

<h2 id="usage">Usage</h2>

<Content />

<h2 id="attributes">Attributes</h2>

<div>
	{
		attributes.map((attribute) => (
			<section id={attribute.name}>
				<ReferenceCard title={attribute.title}>
					<TypeBadge slot="meta" type={attribute.type} />
					<HclConfigs configs={attribute.configs} />
					<Fragment set:html={attribute.html} />
					<Code code={attribute.example.trim()} lang="hcl" />
				</ReferenceCard>
			</section>
		))
	}
</div>

{entry.data.examples && <HclExamples examples={entry.data.examples} />}
