---
/**
 * Conditionally renders its children only when the latest Terragrunt release
 * is equal to or newer than the specified semver version.
 *
 * In dev mode, the version is always treated as released so that new content
 * is visible during local development.
 *
 * `version` must have the form vX.Y.Z; any other form fails the build.
 *
 * Usage in .mdx files:
 *   <Since version="v1.1.0">
 *     Content shown only when the latest release is >= v1.1.0
 *   </Since>
 *
 * IMPORTANT: Do not use markdown headings (##, ###, etc.) inside <Since>.
 * Starlight extracts headings at build time before the component renders,
 * so hidden headings will still appear in the Table of Contents.
 */
import { isPublished } from '@lib/release';
import { assertReleaseVersion } from '@lib/versions';

interface Props {
  version: string;
}

const { version } = Astro.props;

assertReleaseVersion(version);

const published = await isPublished(version);
---

{published && <slot />}
