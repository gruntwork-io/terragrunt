---
import { Badge } from '@astrojs/starlight/components';
import { typeBadgeLabel, typeBadgeVariant } from '@lib/type-badge';

interface Props {
	type: string;
	optional?: boolean;
	defaultVal?: string | undefined;
}

const { type, optional = false, defaultVal } = Astro.props;
---

<Badge
	class="type-badge"
	text={typeBadgeLabel(type, optional, defaultVal)}
	variant={typeBadgeVariant(type)}
	size="small"
	style={{ fontWeight: 'bold' }}
/>

<style>
	.type-badge {
		margin-inline-start: auto;
	}
</style>
