---
/**
 * Note for a changelog entry listed under breaking changes even though it
 * stays inside the 1.0 guarantees. The text ahead of the slot comes from
 * `@lib/changelog`, which also rewrites this component for GitHub release
 * notes.
 *
 * Usage in .mdx files:
 *   <WithinGuarantees>
 *     `base64gzip()` still returns valid gzipped base64 content, but the encoded value changes.
 *   </WithinGuarantees>
 */
import { Aside } from '@astrojs/starlight/components';
import { WITHIN_GUARANTEES_NOTE, WITHIN_GUARANTEES_TITLE } from '@lib/changelog';

// The note is Markdown with plain links only, so a link rewrite is all the
// rendering it needs.
const noteHtml = WITHIN_GUARANTEES_NOTE.replace(
  /\[([^\]]+)\]\(([^)]+)\)/g,
  '<a href="$2">$1</a>',
);
---

<Aside type="note" title={WITHIN_GUARANTEES_TITLE}>
  <p set:html={noteHtml} />

  <slot />
</Aside>
