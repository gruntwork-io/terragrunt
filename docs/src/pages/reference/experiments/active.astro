export const prerender = true;
---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ExperimentEntries from '@components/ExperimentEntries.astro';
import { getCollection } from 'astro:content';
import { getLatestVersion } from '@lib/release';
import { isCompleted } from '@lib/experiments';
import { isReleased } from '@lib/versions';

const showUnreleased = import.meta.env.DEV;

const latestVersion = await getLatestVersion();

const allEntries = await getCollection('experiments');

const entries = allEntries
	.filter((e) => !isCompleted(e, latestVersion))
	.filter((e) => showUnreleased || !e.data.since || isReleased(e.data.since, latestVersion))
	.sort((a, b) => a.data.name.localeCompare(b.data.name));

const headings: { depth: number; slug: string; text: string }[] = [];

for (const entry of entries) {
	headings.push({ depth: 2, slug: entry.data.name, text: entry.data.name });

	const h3Lines = entry.body?.match(/^### .+/gm) ?? [];
	for (const line of h3Lines) {
		const text = line.replace(/^### /, '').replaceAll('`', '');
		const slug = text
			.toLowerCase()
			.replace(/[^\w\s-]/g, '')
			.trim()
			.replace(/\s+/g, '-');
		headings.push({ depth: 3, slug, text });
	}
}
---

<StarlightPage
	frontmatter={{
		title: 'Active Experiments',
		description: 'Experimental features available for opt-in.',
	}}
	headings={headings}
>
	<p>
		The following experiments are available for opt-in. See the <a href="/reference/experiments">experiments overview</a> for how to enable them.
	</p>
	<hr />
	<ExperimentEntries status="active" showUnreleased={showUnreleased} />
</StarlightPage>
