---
/**
 * The comparison and guide index lists.
 *
 * `.terragrunt-comparisons-list` is a single stacked column of title-only
 * links — a --gray-6 fill on a --gray-4 hairline, 8px radius, 20/24 padding,
 * 16px apart. Built as a two-column grid of cards with descriptions and a
 * "Read more" affordance it read as a different component and carried copy the
 * live page does not show.
 */
interface Card {
  href: string;
  title: string;
}

interface Props {
  cards: readonly Card[];
}

const { cards } = Astro.props;
---

<ul class="m-0 mt-6 flex list-none flex-col gap-4 p-0 pb-4">
  {
    cards.map((card) => (
      <li>
        <a
          href={card.href}
          class="flex w-full items-center justify-between rounded-lg border border-gray-4 bg-gray-6 px-6 py-5 text-lg font-medium leading-[150%] text-gray-7 no-underline transition-colors hover:border-accent-3 hover:text-accent-1"
        >
          {card.title}
        </a>
      </li>
    ))
  }
</ul>
