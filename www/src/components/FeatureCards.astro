---
import { renderLede } from "@lib/lede";
import type { FeatureCard } from "@data/home";

interface Props {
  cards: readonly FeatureCard[];
  /** `dotted` separates with dashed rules; `solid` boxes each card. */
  style?: "dotted" | "solid";
  columns?: 1 | 2 | 3;
}

const { cards, style = "dotted", columns = 3 } = Astro.props;

const grid = {
  1: "grid-cols-1",
  2: "grid-cols-1 md:grid-cols-2",
  3: "grid-cols-1 md:grid-cols-2 lg:grid-cols-3",
}[columns];
---

<div class:list={["grid gap-px", grid]}>
  {
    cards.map((card) => (
      <div
        class:list={[
          "flex flex-col gap-3 p-6",
          style === "solid"
            ? "rounded-xl border border-gray-4 bg-white"
            : "border border-dashed border-gray-4",
        ]}
      >
        <h3 class="m-0 text-base font-semibold text-dark-blue-1">
          {card.title}
        </h3>
        <div
          class="text-sm leading-relaxed text-gray-2 [&_a]:text-accent-1 [&_a]:underline [&_a]:underline-offset-2 [&_p]:m-0"
          set:html={renderLede(card.body)}
        />
      </div>
    ))
  }
</div>
