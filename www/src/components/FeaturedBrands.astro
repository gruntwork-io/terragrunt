---
import { Image } from "astro:assets";
import { featuredBrandsHeadline } from "@data/home";

/*
 * The logo strip scrolls. The list is rendered twice and the track translates by
 * exactly -50%, so the second copy is under the cursor at the moment the
 * animation restarts and the loop has no visible seam. The duplicate is
 * `aria-hidden`, so a screen reader hears each company once.
 */
const logos = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>("../assets/brands/*.svg", {
    eager: true,
  }),
).map(([path, module]) => {
  const name = path.split("/").pop()!.replace(".svg", "");
  return { src: module.default, name };
});

const label = (name: string) => name.charAt(0).toUpperCase() + name.slice(1);
---

{/*
  The label sits on the same row as the logos, left of them — not centred above.
  It is set in the mono face at 12px uppercase, which is what `.featured-brands-text`
  specifies; in the sans face it reads as a heading rather than a rubric.
*/}
<section
  class="border-b border-gray-4 bg-background px-4 py-11 md:px-8"
>
  <div class="mx-auto flex max-w-[1310px] items-center gap-8">
    <h2
      class="m-0 shrink-0 whitespace-nowrap font-mono text-xs uppercase leading-3 text-gray-2"
    >
      {featuredBrandsHeadline}
    </h2>

    <div class="marquee min-w-0 flex-1 overflow-hidden" data-marquee>
      <div class="marquee-track flex w-max items-center gap-14">
        {
          [false, true].map((isDuplicate) =>
            logos.map((logo) => (
              <Image
                src={logo.src}
                alt={isDuplicate ? "" : `The logo for ${label(logo.name)}`}
                aria-hidden={isDuplicate ? "true" : undefined}
                loading="lazy"
                class="h-6 w-auto shrink-0 opacity-70 grayscale"
              />
            )),
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .marquee {
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      black 3rem,
      black calc(100% - 3rem),
      transparent
    );
    mask-image: linear-gradient(
      to right,
      transparent,
      black 3rem,
      black calc(100% - 3rem),
      transparent
    );
  }

  .marquee-track {
    animation: marquee-scroll 40s linear infinite;
  }

  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      /* Exactly one copy of the list. Any other value shows a jump. */
      transform: translateX(-50%);
    }
  }

  /*
   * A continuous animation is the case `prefers-reduced-motion` exists for, and
   * the strip still reads as a logo list when it is still.
   */
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      overflow-x: auto;
    }

    .marquee-track {
      animation: none;
    }
  }
</style>
