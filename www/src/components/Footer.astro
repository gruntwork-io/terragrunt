---
import { Image } from "astro:assets";
import GruntworkLogo from "@assets/gruntwork-logo.svg";
import { footerLinks } from "@data/site";

interface Props {
  tone?: "light" | "dark";
}

const { tone = "light" } = Astro.props;
const year = new Date().getFullYear();
---

<footer class:list={["relative", tone === "dark" ? "bg-bg-dark" : "bg-background"]}>
  {/*
    `.gradient-div` — a 13px bar ruled dark-blue into accent-1 across the
    container width. It is the only thing separating the footer from the page
    on a site whose footer shares the page background; as a hairline border the
    two read as one continuous block.
  */}
  <div
    class="mx-auto h-[13px] max-w-[1312px] bg-[linear-gradient(90deg,var(--color-dark-blue-1)_50%,var(--color-accent-1))]"
    aria-hidden="true"
  >
  </div>

  <div
    class="mx-auto flex max-w-[1312px] flex-col gap-6 px-4 py-10 md:flex-row md:items-center md:justify-between md:px-8"
  >
    <div class="flex flex-col gap-2">
      <a
        href="https://www.gruntwork.io/"
        class:list={[
          "flex items-center gap-2 text-sm no-underline transition-colors",
          tone === "dark"
            ? "text-gray-1 hover:text-white"
            : "text-gray-3 hover:text-dark-blue-1",
        ]}
        rel="noopener noreferrer"
        target="_blank"
      >
        <Image
          src={GruntworkLogo}
          alt="Gruntwork"
          loading="lazy"
          class="h-5 w-auto"
        />
        <span>From the DevOps experts at Gruntwork</span>
      </a>
      <p class:list={["m-0 text-sm", tone === "dark" ? "text-gray-1" : "text-gray-2"]}>
        © {year} Gruntwork, Inc. All rights reserved.
      </p>
    </div>

    <nav class="flex gap-10" aria-label="Footer">
      {
        [footerLinks.left, footerLinks.right].map((group) => (
          <ul class="m-0 flex list-none flex-col gap-2 p-0">
            {group.map((link) => (
              <li>
                <a
                  href={link.href}
                  class:list={[
                    "text-sm no-underline transition-colors hover:text-accent-3",
                    tone === "dark" ? "text-gray-1" : "text-gray-3",
                  ]}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        ))
      }
    </nav>
  </div>
</footer>
