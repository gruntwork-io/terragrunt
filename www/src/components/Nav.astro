---
import { Image } from "astro:assets";
import Button from "@components/Button.astro";
import Search from "@components/Search.astro";
import TerragruntLogo from "@assets/horizontal-logo-light.svg";
import {
  DISCORD_INVITE,
  ENTERPRISE_SUPPORT_URL,
  GITHUB_REPO,
  GITHUB_STARS,
  navLinks,
} from "@data/site";

interface Props {
  /** Current route, so the matching nav link can carry `aria-current`. */
  active?: string;
}

const { active } = Astro.props;
---

<header
  class="sticky top-0 z-50 w-full border-b border-stroke-dark bg-bg-dark"
>
  <nav
    class="mx-auto flex h-[124px] max-w-[1312px] items-center justify-between gap-4 px-4 lg:h-24 lg:px-6"
    aria-label="Main"
  >
    <div class="flex items-center gap-6">
      <a href="/" class="flex shrink-0 items-center" aria-label="Terragrunt home">
        <Image
          src={TerragruntLogo}
          alt="Terragrunt"
          loading="eager"
          class="h-auto w-[150px] md:w-[200px]"
        />
      </a>

      <div class="hidden items-center gap-5 lg:flex">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              aria-current={active === link.href ? "page" : undefined}
              class:list={[
                "text-sm no-underline transition-colors hover:text-white",
                active === link.href ? "text-white" : "text-nav-link",
              ]}
            >
              {link.label}
            </a>
          ))
        }

        <a
          href={GITHUB_REPO}
          rel="noopener noreferrer"
          target="_blank"
          class="flex items-center gap-2 text-sm text-nav-link no-underline transition-colors hover:text-white"
          aria-label={`Terragrunt on GitHub — ${GITHUB_STARS} stars`}
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 16 16"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8"
            ></path>
          </svg>
          <span>{GITHUB_STARS}</span>
        </a>

        <a
          href={DISCORD_INVITE}
          rel="noopener noreferrer"
          target="_blank"
          class="text-nav-link transition-colors hover:text-white"
          aria-label="Join the Terragrunt Discord"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 16 16"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M13.545 2.907a13.2 13.2 0 0 0-3.257-1.011.05.05 0 0 0-.052.025c-.141.25-.297.577-.406.833a12.2 12.2 0 0 0-3.658 0 8 8 0 0 0-.412-.833.05.05 0 0 0-.052-.025c-1.125.194-2.22.534-3.257 1.011a.04.04 0 0 0-.021.018C.356 6.024-.213 9.047.066 12.032q.003.022.021.037a13.3 13.3 0 0 0 3.995 2.02.05.05 0 0 0 .056-.019q.463-.63.818-1.329a.05.05 0 0 0-.01-.059l-.018-.011a9 9 0 0 1-1.248-.595.05.05 0 0 1-.02-.066l.015-.019q.127-.095.248-.195a.05.05 0 0 1 .051-.007c2.619 1.196 5.454 1.196 8.041 0a.05.05 0 0 1 .053.007q.121.1.248.195a.05.05 0 0 1-.004.085 8 8 0 0 1-1.249.594.05.05 0 0 0-.03.03.05.05 0 0 0 .003.041c.24.465.515.909.817 1.329a.05.05 0 0 0 .056.019 13.2 13.2 0 0 0 4.001-2.02.05.05 0 0 0 .021-.037c.334-3.451-.559-6.449-2.366-9.106a.03.03 0 0 0-.02-.019m-8.198 7.307c-.789 0-1.438-.724-1.438-1.612s.637-1.613 1.438-1.613c.807 0 1.45.73 1.438 1.613 0 .888-.637 1.612-1.438 1.612m5.316 0c-.788 0-1.438-.724-1.438-1.612s.637-1.613 1.438-1.613c.807 0 1.451.73 1.438 1.613 0 .888-.631 1.612-1.438 1.612"
            ></path>
          </svg>
        </a>
      </div>
    </div>

    <div class="flex items-center gap-2 md:gap-3">
      <Search />
      <Button
        href={ENTERPRISE_SUPPORT_URL}
        variant="secondary"
        class="hidden md:inline-flex"
      >
        Enterprise Support
      </Button>
      <Button href="/terragrunt-scale" variant="primary">Terragrunt Scale</Button>

      <button
        type="button"
        class="text-nav-link transition-colors hover:text-white lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-nav-toggle
      >
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M3 6h18M3 12h18M3 18h18"></path>
        </svg>
      </button>
    </div>
  </nav>

  <div
    id="mobile-nav"
    class="border-t border-stroke-dark bg-bg-dark px-4 pb-4 lg:hidden"
    hidden
  >
    <ul class="m-0 flex list-none flex-col gap-1 p-0">
      {
        [
          ...navLinks,
          { label: `GitHub — ${GITHUB_STARS}`, href: GITHUB_REPO },
          { label: "Discord", href: DISCORD_INVITE },
          { label: "Enterprise Support", href: ENTERPRISE_SUPPORT_URL },
        ].map((link) => (
          <li>
            <a
              href={link.href}
              class="block py-2 text-sm text-nav-link no-underline transition-colors hover:text-white"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  /*
   * `hidden` rather than a display class, because the base stylesheet forces
   * `[hidden]` off and a utility class would race it.
   */
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const panel = document.getElementById("mobile-nav");

  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    toggle.setAttribute("aria-label", open ? "Open menu" : "Close menu");
    if (panel) panel.hidden = open;
  });
</script>
