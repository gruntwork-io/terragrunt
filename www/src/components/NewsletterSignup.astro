---
import HubspotForm from "@components/HubspotForm.astro";
---

{/*
  `.newsletter-container` runs the full width of the page container with square
  corners, and `.gradient-div` under it is what closes the page — the same 13px
  rule the footer carries on pages that have no newsletter.
*/}
<section class="mt-[76px]">
  <div
    class="relative flex flex-col gap-8 bg-bg-dark px-6 py-6 md:flex-row md:items-start md:justify-between md:px-20"
  >
    <div class="mt-4 max-w-[525px]">
      <h2 class="m-0 text-base font-medium leading-5 text-white">
        Join the Terragrunt Newsletter!
      </h2>
      <p class="mt-1 text-base leading-5 text-gray-1">
        Hear about the latest updates, features and innovations in Terragrunt.
      </p>
    </div>

    <HubspotForm
      formName="Newsletter Form"
      tone="dark"
      class="w-full md:max-w-[380px]"
      layout="inline"
      submitLabel="Subscribe"
      successMessage="Thank you! You're on the list."
      fields={[
        {
          name: "email",
          label: "Email",
          type: "email",
          required: true,
          placeholder: "Your email here",
        },
      ]}
    />
  </div>
  <div
    class="h-[13px] bg-[linear-gradient(90deg,var(--color-dark-blue-1)_50%,var(--color-accent-1))]"
    aria-hidden="true"
  >
  </div>
</section>
