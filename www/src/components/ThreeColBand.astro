---
/**
 * A heading over three dashed blocks across — `._3-col-block-container` on the
 * landing pages and the Drift band.
 *
 * The landing pages render their feature groups this way, not as a vertical
 * list; as a stacked list they ran about a third shorter than the live pages.
 */
import { renderLede } from "@lib/lede";

interface Props {
  eyebrow?: string;
  headlineAccent: string;
  headline: string;
  features: readonly { title: string; body: string }[];
}

const { eyebrow, headlineAccent, headline, features } = Astro.props;
---

<section class="px-4 py-[76px] md:px-8">
  <div class="mx-auto max-w-[900px]">
    <div class="mb-[60px] px-6">
      {
        eyebrow && (
          <span class="mb-8 inline-block bg-accent-background px-2 py-0.5 font-mono text-[11px] font-medium uppercase tracking-[0.06em] text-accent-1">
            {eyebrow}
          </span>
        )
      }
      <h2
        class="m-0 text-[2rem] font-medium leading-[1.5em] text-dark-blue-1 md:text-[42px]"
      >
        <span class="text-accent-1">{headlineAccent}</span>{" "}{headline}
      </h2>
    </div>

    <div class="grid grid-cols-1 border-y border-dashed border-gray-4 sm:grid-cols-3">
      {
        features.map((feature, i) => (
          <div
            class:list={[
              "flex flex-col gap-4 p-6",
              i < features.length - 1 &&
                "sm:border-r sm:border-dashed sm:border-gray-4",
            ]}
          >
            <h3 class="m-0 text-base font-semibold text-dark-blue-1">
              {feature.title}
            </h3>
            <div
              class="text-sm leading-relaxed text-gray-2 [&_code]:rounded [&_code]:bg-gray-6 [&_code]:px-1 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-[0.85em] [&_code]:text-accent-1 [&_p]:m-0"
              set:html={renderLede(feature.body)}
            />
          </div>
        ))
      }
    </div>
  </div>
</section>
