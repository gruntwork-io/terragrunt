---
/**
 * A demo-request landing page: offer and form at the top, product sections
 * below, testimonial last.
 *
 * These pages are `noindex` by default. They are campaign destinations whose
 * copy overlaps the Terragrunt Scale page almost entirely, and letting both
 * compete for the same queries is how a product page loses its own ranking.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import ThreeColBand from "@components/ThreeColBand.astro";
import VerticalGrid from "@components/VerticalGrid.astro";
import Footer from "@components/Footer.astro";
import HubspotForm from "@components/HubspotForm.astro";
import Nav from "@components/Nav.astro";
import { testimonial } from "@data/terragrunt-scale";

export interface LandingSection {
  eyebrow?: string;
  headlineLead: string;
  headlineAccent: string;
  features: readonly { title: string; body: string }[];
}

interface Props {
  title: string;
  description: string;
  path: string;
  formName: string;
  sections: readonly LandingSection[];
  noindex?: boolean;
}

const {
  title,
  description,
  path,
  formName,
  sections,
  noindex = true,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  noindex={noindex}
>
  <VerticalGrid />
  <Nav />

  <div class="global-page-container">
    <main class="mx-auto w-full max-w-[1310px]">
      <slot name="hero" />
      <slot name="before-form" />

      <section class="px-4 py-[76px] md:px-8">
        <div class="grid grid-cols-1 items-start gap-[96px] rounded-3xl border-[6px] border-gray-5 bg-bg-dark p-8 lg:grid-cols-2 lg:p-12">
          <div class="flex max-w-[560px] flex-col gap-8">
            <slot name="offer" />
          </div>

          <div>
            <HubspotForm
              formName={formName}
              tone="dark"
              submitLabel="Request a demo"
              successMessage="Thank you! Your submission has been received. We generally respond the same business day."
              fields={[
                { name: "name", label: "Name", required: true },
                {
                  name: "email",
                  label: "Company email",
                  type: "email",
                  required: true,
                },
                { name: "phone", label: "Phone number", type: "tel" },
                {
                  name: "how-did-you-hear",
                  label: "How did you hear about us?",
                  required: true,
                },
                {
                  name: "How-can-we-help",
                  label: "How can we help?",
                  type: "textarea",
                  required: true,
                },
              ]}
            />
            <p class="mt-4 text-center text-sm text-gray-1">
              We generally respond the same business day!
            </p>
          </div>
        </div>
      </section>

      <slot name="after-form" />

      {
        sections.map((section) => (
          <ThreeColBand
            eyebrow={section.eyebrow}
            headlineAccent={section.headlineLead}
            headline={section.headlineAccent}
            features={section.features}
          />
        ))
      }

      <section class="border-t border-gray-4 px-4 py-[76px] md:px-8">
        <figure class="mx-auto max-w-[820px] text-center">
          <blockquote class="m-0 text-xl leading-relaxed text-gray-7">
            &ldquo;{testimonial.quote}&rdquo;
          </blockquote>
          <figcaption class="mt-6">
            <span class="block font-semibold text-dark-blue-1"
              >{testimonial.name}</span
            >
            <span class="block text-sm text-gray-2">{testimonial.role}</span>
          </figcaption>
        </figure>
      </section>

      <div class="h-[150px]"></div>
    </main>
  </div>

  <Footer />
</BaseLayout>
