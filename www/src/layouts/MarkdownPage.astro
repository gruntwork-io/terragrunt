---
/**
 * Layout for a standalone Markdown page under `src/pages`.
 *
 * Astro passes a markdown page's frontmatter as `Astro.props.frontmatter`,
 * not as individual props, so this reads it from there rather than destructuring
 * `Astro.props` directly.
 */
import PageLayout from "@layouts/PageLayout.astro";

interface Frontmatter {
  title: string;
  description?: string;
  path: string;
  eyebrow?: string;
  headline: string;
  subhead?: string;
  cta?: boolean;
  newsletter?: boolean;
  openSource?: boolean;
}

const { frontmatter } = Astro.props as { frontmatter: Frontmatter };
---

<PageLayout
  title={frontmatter.title}
  description={frontmatter.description}
  path={frontmatter.path}
  eyebrow={frontmatter.eyebrow}
  headline={frontmatter.headline}
  subhead={frontmatter.subhead}
  cta={frontmatter.cta}
  newsletter={frontmatter.newsletter}
  openSource={frontmatter.openSource}
>
  <div class="prose-tg">
    <slot />
  </div>
</PageLayout>
