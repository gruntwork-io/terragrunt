---
/**
 * The standard content page: hero, body, then the three bands every non-landing
 * page on the site closes with. A page that needs a different tail composes
 * `BaseLayout` directly rather than adding a flag here.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import CtaSection from "@components/CtaSection.astro";
import Footer from "@components/Footer.astro";
import Nav from "@components/Nav.astro";
import NewsletterSignup from "@components/NewsletterSignup.astro";
import OpenSourceTools from "@components/OpenSourceTools.astro";
import PageHero from "@components/PageHero.astro";

interface Props {
  title: string;
  description?: string;
  path: string;
  eyebrow?: string;
  headline: string;
  subhead?: string;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
  /** Drops the Terragrunt Scale CTA band, for pages that are themselves the CTA. */
  hideCta?: boolean;
}

const {
  title,
  description,
  path,
  eyebrow,
  headline,
  subhead,
  jsonLd,
  noindex,
  hideCta = false,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  jsonLd={jsonLd}
  noindex={noindex}
>
  <Nav active={path} />
  <PageHero eyebrow={eyebrow} headline={headline} subhead={subhead} />

  <div class="global-page-container">
    <main class="mx-auto w-full max-w-[1310px]">
      <div class="mx-auto max-w-[800px] px-4 py-14 md:px-8">
        <slot />
      </div>

      {!hideCta && <CtaSection />}
      <NewsletterSignup />
    </main>
  </div>

  <div class="mt-16">
    <OpenSourceTools />
    <Footer />
  </div>
</BaseLayout>
