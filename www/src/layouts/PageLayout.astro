---
/**
 * The standard content page: hero, body, then the three bands every non-landing
 * page on the site closes with. A page that needs a different tail composes
 * `BaseLayout` directly rather than adding a flag here.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import CtaSection from "@components/CtaSection.astro";
import Footer from "@components/Footer.astro";
import Nav from "@components/Nav.astro";
import NewsletterSignup from "@components/NewsletterSignup.astro";
import OpenSourceTools from "@components/OpenSourceTools.astro";
import PageHero from "@components/PageHero.astro";
import VerticalGrid from "@components/VerticalGrid.astro";

interface Props {
  title: string;
  description?: string;
  path: string;
  eyebrow?: string;
  headline: string;
  subhead?: string;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
  /*
   * The closing bands are NOT the same on every page, and assuming they were
   * added roughly a thousand pixels of content to pages that end at the footer.
   * On the live site: /faqs-overview and both index pages close immediately;
   * /faq/* carries all three; /comparisons/* drops the CTA; /guides/* keeps only
   * the newsletter; /ai-info-page keeps only the open-source band.
   */
  cta?: boolean;
  newsletter?: boolean;
  openSource?: boolean;
}

const {
  title,
  description,
  path,
  eyebrow,
  headline,
  subhead,
  jsonLd,
  noindex,
  cta = false,
  newsletter = false,
  openSource = false,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  jsonLd={jsonLd}
  noindex={noindex}
>
  <VerticalGrid />
  <Nav active={path} />
  <PageHero eyebrow={eyebrow} headline={headline} subhead={subhead} />

  <div class="global-page-container">
    <main class="mx-auto w-full max-w-[1310px]">
      <div class="px-4 pb-14 pt-[76px] md:px-8">
        <div class="mx-auto max-w-[800px]">
          <slot />
        </div>
      </div>

      {cta && <CtaSection />}
      {newsletter && <NewsletterSignup />}
    </main>
  </div>

  {openSource && <OpenSourceTools />}
  <Footer />
</BaseLayout>
