---
import BaseLayout from "@layouts/BaseLayout.astro";
import Footer from "@components/Footer.astro";
import HubspotForm from "@components/HubspotForm.astro";
import Nav from "@components/Nav.astro";
import OpenSourceTools from "@components/OpenSourceTools.astro";

const title = "Terragrunt Scale | Contact";
const description =
  "Talk to the team about Terragrunt Scale: centralized pipelines, drift detection, and expert support for your IaC estate.";

/*
 * The meetings embed is HubSpot's own iframe. It is behind a tab rather than
 * loaded alongside the form, so a visitor who only wants to send a message
 * never pays for it.
 */
const MEETINGS_URL =
  "https://meetings.hubspot.com/chris-pham/book-a-demo-terragrunt-scale?embed=true";
---

<BaseLayout title={title} description={description} path="/contact-tgs">
  <Nav />

  <div class="global-page-container">
    <main class="mx-auto w-full max-w-[1310px] px-4 py-16 md:px-8">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-2">
        <div class="max-w-[520px]">
          <h1
            class="m-0 text-3xl font-semibold leading-tight tracking-[-0.01em] text-dark-blue-1 md:text-4xl"
          >
            Interested in Terragrunt Scale?
          </h1>
          <p class="mt-5 text-lg leading-relaxed text-gray-2">
            Scale your IaC estate with centralized pipelines, drift detection,
            and expert support. We&rsquo;ll start by asking about your current
            infrastructure needs and goals. Then we&rsquo;ll show you what&rsquo;s
            possible with Terragrunt Scale.
          </p>
          <p class="mt-8 text-sm font-medium text-gray-3">
            Thousands of engineers build with Terragrunt
          </p>
        </div>

        <div class="rounded-2xl border border-gray-4 bg-white p-6 md:p-8">
          <div
            class="mb-6 flex gap-1 rounded-lg bg-gray-6 p-1"
            role="tablist"
            aria-label="Contact method"
          >
            <button
              type="button"
              role="tab"
              id="tab-message"
              aria-controls="panel-message"
              aria-selected="true"
              class="flex-1 rounded-md px-4 py-2 text-sm font-medium transition-colors aria-selected:bg-white aria-selected:text-dark-blue-1 aria-selected:shadow-sm"
              data-contact-tab="message"
            >
              Send a Message
            </button>
            <button
              type="button"
              role="tab"
              id="tab-call"
              aria-controls="panel-call"
              aria-selected="false"
              class="flex-1 rounded-md px-4 py-2 text-sm font-medium transition-colors aria-selected:bg-white aria-selected:text-dark-blue-1 aria-selected:shadow-sm"
              data-contact-tab="call"
            >
              Book a Call
            </button>
          </div>

          <div id="panel-message" role="tabpanel" aria-labelledby="tab-message">
            <HubspotForm
              formName="Terragrunt Contact Form"
              submitLabel="Send message"
              successMessage="Thank you! Your submission has been received. We generally respond the same business day."
              fields={[
                { name: "name", label: "Name", required: true },
                { name: "Company", label: "Company name", required: true },
                {
                  name: "email",
                  label: "Company email",
                  type: "email",
                  required: true,
                },
                { name: "Phone", label: "Phone number", type: "tel" },
                {
                  name: "Source",
                  label: "How did you hear about us?",
                  required: true,
                },
                {
                  name: "Message",
                  label: "How can we help?",
                  type: "textarea",
                  required: true,
                },
              ]}
            />
            <p class="mt-4 text-sm text-gray-2">
              We generally respond the same business day!
            </p>
          </div>

          <div id="panel-call" role="tabpanel" aria-labelledby="tab-call" hidden>
            {/*
              `data-src` rather than `src`: the iframe is only pointed at
              HubSpot once someone opens this tab, so the default view costs no
              third-party request.
            */}
            <iframe
              data-src={MEETINGS_URL}
              title="Book a demo of Terragrunt Scale"
              class="h-[680px] w-full rounded-lg border-0"
              loading="lazy"
              data-contact-meetings></iframe>
          </div>
        </div>
      </div>
    </main>
  </div>

  <div class="mt-16">
    <OpenSourceTools />
    <Footer />
  </div>
</BaseLayout>

<script>
  const tabs =
    document.querySelectorAll<HTMLButtonElement>("[data-contact-tab]");
  const meetings = document.querySelector<HTMLIFrameElement>(
    "[data-contact-meetings]",
  );

  for (const tab of tabs) {
    tab.addEventListener("click", () => {
      for (const other of tabs) {
        const selected = other === tab;
        other.setAttribute("aria-selected", String(selected));
        const panel = document.getElementById(
          `panel-${other.dataset.contactTab}`,
        );
        if (panel) panel.hidden = !selected;
      }

      if (tab.dataset.contactTab === "call" && meetings && !meetings.src) {
        meetings.src = meetings.dataset.src ?? "";
      }
    });
  }
</script>
