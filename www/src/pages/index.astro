---
import { Image } from "astro:assets";
import BaseLayout from "@layouts/BaseLayout.astro";
import Button from "@components/Button.astro";
import CtaSection from "@components/CtaSection.astro";
import FeatureCards from "@components/FeatureCards.astro";
import FeaturedBrands from "@components/FeaturedBrands.astro";
import Footer from "@components/Footer.astro";
import Nav from "@components/Nav.astro";
import NewsletterSignup from "@components/NewsletterSignup.astro";
import NotificationBar from "@components/NotificationBar.astro";
import VerticalGrid from "@components/VerticalGrid.astro";
import OpenSourceTools from "@components/OpenSourceTools.astro";
import ScalePanel from "@components/ScalePanel.astro";
import SectionHeading from "@components/SectionHeading.astro";
import OpenTofuMark from "@assets/img/opentofu-logo.svg";
import TerraformMark from "@assets/img/terraform-logo.svg";
import heroBg from "@assets/img/hero-bg.png";
import Testimonials from "@components/Testimonials.astro";
import {
  consistencySection,
  drySection,
  hero,
  orchestrateSection,
} from "@data/home";

const title = "Terragrunt | Orchestrate Terraform & OpenTofu at Scale";
const description =
  "Standardize IaC and manage growing infra complexity: define units & stacks, cut repetition with includes/hooks, execute modules in dependency order across environments.";

/* Carried over verbatim from the Webflow build — the one page that had it. */
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Terragrunt",
  url: "https://terragrunt.com",
  description,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Linux, macOS, Windows",
  inLanguage: "en",
};

/* The first three cards sit above the second headline, the last two below it. */
const builtFor = [
  { label: "OpenTofu", mark: OpenTofuMark },
  { label: "Terraform", mark: TerraformMark },
];

const consistencyTop = consistencySection.cards.slice(0, 3);
const consistencyBottom = consistencySection.cards.slice(3);
---

<BaseLayout title={title} description={description} path="/" jsonLd={jsonLd}>
  <VerticalGrid />
  <NotificationBar />
  <Nav active="/" />

  <section class="relative z-[1] min-h-[600px] w-full bg-bg-dark">
    {/*
      The dotted field is a real asset positioned at `50% 110%` / contain, the
      same as `.hero-container` on the live site. Painted flat navy the band
      looks like a placeholder for it.
    */}
    <div
      class="mx-auto min-h-[650px] max-w-[1310px] bg-[length:contain] bg-[position:50%_110%] bg-no-repeat pt-[60px]"
      style={`background-image:url(${heroBg.src})`}
    >
      <div
        class="mx-auto flex max-w-[1000px] flex-col items-center gap-6 px-4 text-center md:px-8"
      >
        <h1
          class="m-0 w-full max-w-[1000px] text-[32px] font-medium leading-[48px] tracking-[-0.01em] text-white md:text-[60px] md:leading-[72px]"
        >
          The Open Source<br />IaC Orchestrator<br />Platform Teams Trust
        </h1>
        <p class="m-0 max-w-[60ch] text-lg leading-[1.55] text-gray-1">
          {hero.subhead}
        </p>

        {/* Built For sits ABOVE the buttons on the live page, not below them. */}
        <p class="m-0 flex flex-wrap items-center justify-center gap-2">
          <span
            class="font-mono text-[11px] uppercase tracking-[0.08em] text-gray-1"
            >{hero.builtForLabel}</span
          >
          {
            builtFor.map((tool) => (
              <span class="inline-flex items-center gap-1.5 rounded-full bg-background px-3 py-1 text-xs font-medium text-bg-dark">
                <Image src={tool.mark} alt="" aria-hidden="true" class="size-4" />
                {tool.label}
              </span>
            ))
          }
        </p>

        <div class="flex flex-wrap items-center justify-center gap-3">
          <Button href={hero.secondary.href} variant="secondary" size="lg">
            {hero.secondary.label}
          </Button>
          <Button href={hero.primary.href} variant="primary" size="lg">
            {hero.primary.label}
          </Button>
        </div>
      </div>
    </div>
  </section>

  <div class="global-page-container">
    <main class="mx-auto w-full max-w-[1310px]">
      <FeaturedBrands />

      {/*
        Two columns — headline left, cards stacked right — not a headline above
        a three-across row. `._2-col` is `grid-template-columns: 1fr 1fr`.
      */}
      <section class="px-4 py-[76px] md:px-8">
        <div class="mx-auto grid max-w-[900px] grid-cols-1 gap-4 lg:grid-cols-2 lg:pl-14">
          <SectionHeading
            eyebrow={orchestrateSection.eyebrow}
            words={[
              orchestrateSection.headline,
              orchestrateSection.headlineAccent,
            ]}
            accent={[orchestrateSection.headlineAccent]}
          />
          <FeatureCards cards={orchestrateSection.cards} columns={1} />
        </div>
      </section>

      <ScalePanel />

      <section class="mx-auto my-[88px] max-w-[960px] px-4 md:px-8">
        <div class="mx-auto max-w-[850px] px-0 md:px-8">
        <SectionHeading
          eyebrow={consistencySection.eyebrow}
          words={consistencySection.headline}
          accent={["Tribal"]}
        />
        </div>
        <div class="mt-[60px]"><FeatureCards cards={consistencyTop} columns={3} /></div>

        <div class="mt-16">
          <div class="mx-auto max-w-[850px] px-0 md:px-8">
            <SectionHeading
              words={consistencySection.secondHeadline}
              accent={["Enable"]}
            />
          </div>
          <FeatureCards cards={consistencyBottom} columns={2} />
        </div>
      </section>

      <section class="mx-auto my-[88px] max-w-[960px] px-4 md:px-8">
        <div class="mx-auto max-w-[850px] px-0 md:px-8">
        <SectionHeading
          eyebrow={drySection.eyebrow}
          words={[drySection.headlineAccent, drySection.headline]}
          accent={[drySection.headlineAccent]}
        />
        </div>
        <FeatureCards cards={drySection.cards} columns={2} style="solid" />
      </section>

      <Testimonials />
      <CtaSection />
      <NewsletterSignup />
    </main>
  </div>

  <div class="mt-16">
    <OpenSourceTools />
    <Footer gradient={false} />
  </div>
</BaseLayout>
