---
import { Image } from "astro:assets";
import FeaturedBrands from "@components/FeaturedBrands.astro";
import LandingLayout from "@layouts/LandingLayout.astro";
import ProductTiles from "@components/ProductTiles.astro";
import BoxesBg from "@assets/img/boxes-bg.svg";
import Keychron from "@assets/img/keychron-1.png";
import DgxSpark from "@assets/img/keychron-2.png";

const steps = [
  {
    title: "See Terragrunt Scale in action",
    body: "We'll walk through how Scale solves your specific infrastructure challenges. Bring questions — this is your session.",
  },
  {
    title: "Get your Keychron keyboard + DGX Spark raffle entry",
    body: "After the demo, we ship your mechanical keyboard and enter you into the DGX Spark drawing. You can choose any Keychron keyboard up to $150, or we can send you a Keychron gift card to purchase your perfect keyboard.",
  },
];

const prizes = [
  {
    title: "Keychron Mechanical Keyboard",
    body: "Every person who books and completes a demo gets a Keychron mechanical keyboard shipped to their door.",
    image: Keychron,
    imageAlt: "A Keychron mechanical keyboard",
  },
  {
    title: "NVIDIA DGX Spark",
    body: "Completing the demo also enters you into a raffle for an NVIDIA DGX Spark! Drawing for the winner will be on July 15th.",
    image: DgxSpark,
    imageAlt: "An NVIDIA DGX Spark",
  },
];

const sections = [
  {
    headlineLead: "Deploy",
    headlineAccent: "infra changes with confidence",
    features: [
      {
        title: "Deploy safely with Pipelines",
        body: "Run plans only for affected units, post results back to PRs, and apply on merge in dependency order. Pipelines supports concurrent runs for independent units, multi-environment changes, HCL-based configuration, and OIDC credentials scoped to each environment.",
      },
      {
        title: "Detect drift before it becomes an incident",
        body: "Run scheduled or on-demand scans. When drift is found, open a PR or MR for only the drifted units, review the remediation, and merge when ready. Start narrow with filtered coverage and expand over time.",
      },
      {
        title: "Keep IaC current",
        body: "Patcher opens pull requests for dependency updates on your schedule and promotes them across environments in order.",
      },
    ],
  },
  {
    kind: "cols" as const,
    headlineLead: "Terragrunt-native GitOps,",
    headlineAccent: "not retrofitted from generic CI",
    features: [
      {
        title: "Runs where your code already runs",
        body: "Your existing GitHub Actions or GitLab CI, not a separate runner fleet you have to operate.",
      },
      {
        title: "Speaks Terragrunt",
        body: "Understands units, stacks, and the dependency graph rather than treating every directory as an island.",
      },
      {
        title: "Minimal blast radius",
        body: "Plans and applies only the units your change actually affects.",
      },
      {
        title: "No long-lived secrets",
        body: "Temporary, least-privilege OIDC credentials scoped per environment.",
      },
      {
        title: "Fits your repo layout",
        body: "Monorepos or polyrepos, GitHub or GitLab, cloud or enterprise/self-managed.",
      },
      {
        title: "Configured in HCL",
        body: "Workflow behaviour stays in code you can read and review, not behind a black box.",
      },
    ],
  },
];
---

<LandingLayout
  title="Terragrunt Scale | Keychron"
  description="Take a demo of Terragrunt Scale and we'll ship you a Keychron mechanical keyboard, plus you'll be entered in a raffle for an NVIDIA DGX Spark."
  path="/lp/keychron"
  formName="Keychron Contact Form"
  sections={sections}
  contact="offer-wide"
  quoteTone="accent"
  spacer={false}
>
  <Fragment slot="hero">
    {/*
      `.hero-section` / `.hero-container-no-scale` — the milestone banner. The
      headline runs at 64px here rather than the 60px the other landing hero
      uses, and the band carries the boxes plate behind the prize tiles.
    */}
    <section class="relative z-[2] w-full bg-bg-dark">
      <div
        class="mx-auto min-h-[650px] max-w-[1310px] bg-[position:50%_120%] bg-contain bg-no-repeat px-4 pb-[60px] pt-[150px] md:px-0"
        style={`background-image:url(${BoxesBg.src})`}
      >
        <h1
          class="m-0 max-w-[900px] text-[40px] font-medium leading-[1.15] text-white md:text-[64px] md:leading-[73.6px]"
        >
          Terragrunt 1.0 is here. Check out{" "}<span class="text-accent-4"
            >Terragrunt Scale!</span
          >
        </h1>
        <div class="mt-6 max-w-[600px] text-lg leading-7 text-gray-1">
          <p class="m-0 mb-2.5">
            We&rsquo;re celebrating the biggest Terragrunt milestone yet! If
            you&rsquo;re using Terragrunt in production, we want to celebrate
            with you!
          </p>
          <p class="m-0">
            <strong class="font-bold"
              >Take a demo of Terragrunt Scale and we&rsquo;ll ship you a
              Keychron mechanical keyboard, plus you&rsquo;ll be entered in a
              raffle for an NVIDIA DGX Spark.</strong
            >
          </p>
        </div>

        <ProductTiles tiles={prizes} columns={2} />
      </div>
    </section>
  </Fragment>

  <Fragment slot="offer">
    <h1
      class="m-0 text-[40px] font-medium leading-tight text-white md:text-[60px] md:leading-[60px]"
    >
      30 minutes. <span class="text-accent-4">A free keyboard.</span> A shot at a
      DGX Spark.
    </h1>

    <ol class="m-0 flex list-none flex-col gap-6 p-0 text-lg leading-7">
      {
        steps.map((step) => (
          <li>
            <h2 class="m-0 text-lg font-bold leading-7 text-white">
              {step.title}
            </h2>
            <p class="m-0 text-gray-1">{step.body}</p>
          </li>
        ))
      }
    </ol>

    <div class="grid grid-cols-2 gap-2.5">
      {
        prizes.map((prize) => (
          <Image
            src={prize.image}
            alt={prize.imageAlt}
            loading="lazy"
            class="w-full rounded-lg"
          />
        ))
      }
    </div>
  </Fragment>

  <Fragment slot="before-form">
    <FeaturedBrands />
  </Fragment>

  <Fragment slot="after-form">
    {/*
      `.container` + `.flush-block`: a centred 42px headline over one 850px
      block ruled top and bottom. It is the page's only long-form passage and
      the rule is what keeps it from reading as a stray paragraph.
    */}
    <section class="px-4 py-[76px] md:px-8">
      <div class="mx-auto max-w-[900px]">
        <h2
          class="m-0 px-8 text-[2rem] font-medium leading-[1.15] text-dark-blue-1 md:text-[42px] md:leading-[46.67px]"
        >
          Built for teams that use{" "}<span class="text-accent-1"
            >Terragrunt</span
          >
        </h2>
        <div
          class="mx-auto my-8 max-w-[850px] border-y border-dashed border-gray-4 p-6 text-base leading-5 text-gray-2"
        >
          <p class="m-0">
            Terragrunt gives teams a clean way to organize infrastructure.
            Terragrunt Scale extends the Terragrunt you already know with a
            secure, production-grade GitOps workflow&mdash;running entirely
            inside your own GitHub Actions or GitLab CI.
          </p>
          <p class="m-0 mt-5">
            Terragrunt-native GitOps pipelines, drift detection, and automated
            updates. Review plans in pull requests, apply on merge, minimize
            blast radius, and keep your units, stacks, and modules aligned with
            code.
          </p>
        </div>
      </div>
    </section>
  </Fragment>
</LandingLayout>
