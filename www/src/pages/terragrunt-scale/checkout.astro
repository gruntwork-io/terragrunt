---
import BaseLayout from "@layouts/BaseLayout.astro";
import FeaturedBrands from "@components/FeaturedBrands.astro";
import Footer from "@components/Footer.astro";
import Nav from "@components/Nav.astro";

const title = "Terragrunt Scale | Checkout";
const description =
  "Secure GitOps for Terragrunt: GitHub/GitLab pipelines, drift detection with auto-PRs, and patching to keep IaC current; built by the creators of Terragrunt.";

/*
 * Stripe payment links. These are the whole payment path — there is no API key
 * and no server step, so a wrong URL here charges the wrong amount with nothing
 * in between to catch it.
 */
const plans = {
  monthly: {
    price: "$600",
    period: "mo",
    url: "https://buy.stripe.com/00w8wP1bn7aj9aRf4T8g001",
  },
  annual: {
    price: "$500",
    period: "mo *",
    url: "https://buy.stripe.com/fZu7sLg6h7ajevb2i78g002",
  },
};

const steps = [
  {
    number: "01.",
    title: "Sign Up",
    body: "Select your billing cycle and complete payment with Stripe.",
  },
  {
    number: "02.",
    title: "Schedule onboarding",
    body: "Book your onboarding with a Gruntwork Solutions Architect immediately after completing payment.",
  },
  {
    number: "03.",
    title: "Go Live!",
    body: "Meet with us to gain access to the tools and receive hands-on assistance to configure it, as well as practical advice on how to make the most of Terragrunt Scale.",
  },
];

const features = [
  "Terragrunt-native IaC Pipeline",
  "Terragrunt-native Automatic Updates",
  "Terragrunt-native Drift Detection",
  "Premium support",
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  description,
  url: "https://terragrunt.com/terragrunt-scale/checkout",
  inLanguage: "en",
  about: {
    "@type": "Product",
    name: "Terragrunt Scale",
    description:
      "Terragrunt-native IaC Pipeline with automatic updates and drift detection for growing platform teams in production",
    brand: { "@type": "Organization", name: "Gruntwork" },
    offers: {
      "@type": "Offer",
      name: "Team",
      description:
        "For growing platform teams in production - 200 infrastructure units",
      price: "600",
      priceCurrency: "USD",
      priceSpecification: [
        {
          "@type": "UnitPriceSpecification",
          price: "600",
          priceCurrency: "USD",
          billingDuration: "P1M",
          name: "Monthly",
        },
        {
          "@type": "UnitPriceSpecification",
          price: "6000",
          priceCurrency: "USD",
          billingDuration: "P1Y",
          name: "Annual",
        },
      ],
      availability: "https://schema.org/InStock",
    },
  },
};
---

<BaseLayout
  title={title}
  description={description}
  path="/terragrunt-scale/checkout"
  jsonLd={jsonLd}
>
  <Nav active="/terragrunt-scale" />

  <div class="global-page-container">
    <main class="mx-auto w-full max-w-[1310px] px-4 py-16 md:px-8">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-[1fr_400px]">
        <div>
          <span
            class="mb-3 inline-block text-[13px] font-semibold uppercase tracking-[0.08em] text-accent-1"
          >
            Checkout
          </span>
          <h1
            class="m-0 text-3xl font-semibold leading-tight tracking-[-0.01em] text-dark-blue-1 md:text-4xl"
          >
            Purchase <span class="text-accent-1">Terragrunt Scale</span>
          </h1>

          <p
            class="mt-6 flex flex-wrap items-center gap-3 text-xs uppercase tracking-[0.08em] text-gray-2"
          >
            <span>Works With:</span>
            {
              ["Github", "Gitlab"].map((tool) => (
                <span class="rounded-full border border-gray-4 px-3 py-1 normal-case tracking-normal text-dark-blue-1">
                  {tool}
                </span>
              ))
            }
          </p>

          <h2 class="mt-12 text-xl font-semibold text-dark-blue-1">
            How it works
          </h2>
          <ol class="m-0 mt-6 flex list-none flex-col gap-6 p-0">
            {
              steps.map((step) => (
                <li class="flex gap-4">
                  <span class="text-lg font-semibold text-accent-3">
                    {step.number}
                  </span>
                  <div>
                    <h3 class="m-0 text-base font-semibold text-dark-blue-1">
                      {step.title}
                    </h3>
                    <p class="mt-1 text-sm leading-relaxed text-gray-2">
                      {step.body}
                    </p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>

        <aside
          class="h-fit rounded-2xl border border-gray-4 bg-white p-8"
          data-checkout
        >
          <p class="m-0">
            <span
              class="text-4xl font-semibold text-dark-blue-1"
              data-price>{plans.monthly.price}</span
            >
            <span class="text-gray-2">
              / <span data-period>{plans.monthly.period}</span>
            </span>
          </p>

          <h2 class="mt-6 text-xl font-semibold text-dark-blue-1">Team</h2>
          <p class="m-0 mt-1 text-sm font-medium text-accent-1">
            200 infrastructure units &dagger;
          </p>
          <p class="m-0 mt-2 text-sm text-gray-2">
            For growing platform teams in production
          </p>

          <ul class="m-0 mt-6 flex list-none flex-col gap-3 p-0">
            {
              features.map((feature) => (
                <li class="flex items-start gap-2.5 text-sm text-gray-7">
                  <svg
                    class="mt-0.5 size-4 shrink-0 text-accent-3"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                  {feature}
                </li>
              ))
            }
          </ul>

          <div
            class="mt-8 flex gap-1 rounded-lg bg-gray-6 p-1"
            role="radiogroup"
            aria-label="Billing cycle"
          >
            <button
              type="button"
              role="radio"
              aria-checked="true"
              data-plan="monthly"
              data-url={plans.monthly.url}
              data-price-value={plans.monthly.price}
              data-period-value={plans.monthly.period}
              class="flex-1 rounded-md px-4 py-2 text-sm font-medium transition-colors aria-checked:bg-white aria-checked:text-dark-blue-1 aria-checked:shadow-sm"
            >
              Monthly
            </button>
            <button
              type="button"
              role="radio"
              aria-checked="false"
              data-plan="annual"
              data-url={plans.annual.url}
              data-price-value={plans.annual.price}
              data-period-value={plans.annual.period}
              class="flex-1 rounded-md px-4 py-2 text-sm font-medium transition-colors aria-checked:bg-white aria-checked:text-dark-blue-1 aria-checked:shadow-sm"
            >
              Annual
              <span
                class="ml-1.5 rounded-full bg-accent-background px-2 py-0.5 text-xs text-accent-1"
                >17% Off</span
              >
            </button>
          </div>

          <a
            href={plans.monthly.url}
            data-payment-button
            rel="noopener noreferrer"
            class="mt-6 flex w-full items-center justify-center rounded-lg border border-white/20 bg-accent-3 px-6 py-3 text-sm font-medium text-white no-underline transition-colors hover:bg-accent-2"
          >
            Continue to Payment
          </a>

          <p class="m-0 mt-4 text-xs text-gray-2" data-annual-note hidden>
            * Annual contract, billed at $6,000 per year.
          </p>
          <p class="m-0 mt-2 text-xs text-gray-2">
            &dagger; An <a
              href="https://docs.terragrunt.com/getting-started/terminology/#unit"
              class="text-accent-1 underline underline-offset-2"
              rel="noopener noreferrer"
              target="_blank">infrastructure unit</a
            > is any directory containing a <code
              class="rounded bg-gray-6 px-1 py-0.5 font-mono">terragrunt.hcl</code
            > file.
          </p>
        </aside>
      </div>
    </main>

    <FeaturedBrands />
  </div>

  <Footer />
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>("[data-checkout]");
  const options = root?.querySelectorAll<HTMLButtonElement>("[data-plan]") ?? [];
  const price = root?.querySelector<HTMLElement>("[data-price]");
  const period = root?.querySelector<HTMLElement>("[data-period]");
  const button = root?.querySelector<HTMLAnchorElement>("[data-payment-button]");
  const note = root?.querySelector<HTMLElement>("[data-annual-note]");

  for (const option of options) {
    option.addEventListener("click", () => {
      for (const other of options) {
        other.setAttribute("aria-checked", String(other === option));
      }

      // Every value comes off the chosen button, so the price shown and the
      // Stripe link followed can never disagree.
      if (price) price.textContent = option.dataset.priceValue ?? "";
      if (period) period.textContent = option.dataset.periodValue ?? "";
      if (button) button.href = option.dataset.url ?? "";
      if (note) note.hidden = option.dataset.plan !== "annual";
    });
  }
</script>
