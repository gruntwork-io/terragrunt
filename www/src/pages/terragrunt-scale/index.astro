---
import { Image } from "astro:assets";
import BaseLayout from "@layouts/BaseLayout.astro";
import Button from "@components/Button.astro";
import FeatureList from "@components/FeatureList.astro";
import FeaturedBrands from "@components/FeaturedBrands.astro";
import Footer from "@components/Footer.astro";
import Nav from "@components/Nav.astro";
import NewsletterSignup from "@components/NewsletterSignup.astro";
import OpenSourceTools from "@components/OpenSourceTools.astro";
import SectionHeading from "@components/SectionHeading.astro";
import HalfGrunty from "@assets/img/half-grunty.svg";
import PipelinesShot from "@assets/img/tgs-pipelines-plan.png";
import DriftShot from "@assets/img/tgs-drift-detected.png";
import {
  driftDetection,
  faqTeaser,
  hero,
  howItWorks,
  patcher,
  pipelines,
  pricing,
  testimonial,
  video,
} from "@data/terragrunt-scale";

const title = "Terragrunt Scale | Secure GitOps Pipelines & Drift Detection";
const description =
  "Production-grade CI/CD for Terragrunt: plans in your pull requests, drift detection, and automatic module updates, running in your own CI runners.";

/*
 * The hero headline highlights three phrases. Splitting on them keeps the
 * sentence one string in the data file, rather than a list of fragments whose
 * spacing has to be reassembled correctly by whoever edits it next.
 */
const headlineParts = (() => {
  const pattern = new RegExp(`(${hero.accents.join("|")})`, "g");
  return hero.headline.split(pattern);
})();
---

<BaseLayout
  title={title}
  description={description}
  path="/terragrunt-scale"
>
  <Nav active="/terragrunt-scale" />

  <section class="relative overflow-hidden bg-bg-dark px-4 py-20 md:px-8">
    <div class="mx-auto max-w-[900px]">
      <span
        class="mb-4 inline-block text-[13px] font-semibold uppercase tracking-[0.08em] text-accent-3"
      >
        {hero.eyebrow}
      </span>
      <h1
        class="m-0 text-3xl font-semibold leading-[1.15] tracking-[-0.01em] text-white md:text-5xl"
      >
        {hero.headlineLead}{" "}
        {
          headlineParts.map((part) =>
            (hero.accents as readonly string[]).includes(part) ? (
              <span class="text-accent-4">{part}</span>
            ) : (
              part
            ),
          )
        }
      </h1>

      <ul class="m-0 mt-8 flex list-none flex-wrap gap-x-6 gap-y-2 p-0">
        {
          hero.assurances.map((item) => (
            <li class="flex items-center gap-2 text-sm text-gray-1">
              <svg
                class="size-4 shrink-0 text-accent-3"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M20 6 9 17l-5-5" />
              </svg>
              {item}
            </li>
          ))
        }
      </ul>

      <div class="mt-8 flex flex-wrap gap-3">
        <Button href={hero.primary.href} variant="primary" size="lg">
          {hero.primary.label}
        </Button>
        <Button href={hero.secondary.href} variant="secondary" size="lg">
          {hero.secondary.label}
        </Button>
      </div>

      <p
        class="mt-10 flex flex-wrap items-center gap-3 text-xs uppercase tracking-[0.08em] text-gray-1"
      >
        <span>{hero.builtForLabel}</span>
        {
          hero.builtFor.map((tool) => (
            <span class="rounded-full border border-stroke-dark px-3 py-1 normal-case tracking-normal text-white">
              {tool}
            </span>
          ))
        }
      </p>
    </div>

    <Image
      src={HalfGrunty}
      alt=""
      aria-hidden="true"
      loading="lazy"
      class="pointer-events-none absolute bottom-0 right-0 hidden w-56 xl:block"
    />
  </section>

  <div class="global-page-container">
    <main class="mx-auto w-full max-w-[1310px]">
      <FeaturedBrands />

      <section class="px-4 py-14 md:px-8">
        <p class="m-0 mb-4 text-center text-sm text-gray-2">
          <strong class="font-semibold text-dark-blue-1">{video.duration}</strong>
          &nbsp;&bull;&nbsp;Watch a <code
            class="rounded bg-gray-6 px-1 py-0.5 font-mono text-[0.85em] text-accent-1"
            >terragrunt plan</code
          > run in response to a pull request
        </p>
        <div
          class="mx-auto aspect-video w-full max-w-[900px] overflow-hidden rounded-xl border border-gray-4 bg-bg-dark"
        >
          <iframe
            src={`https://player.vimeo.com/video/${video.vimeoId}`}
            title={video.caption}
            class="size-full"
            loading="lazy"
            allow="fullscreen; picture-in-picture"
            allowfullscreen></iframe>
        </div>
      </section>

      <section class="px-4 pb-16 md:px-8">
        <SectionHeading
          eyebrow={howItWorks.eyebrow}
          words={[howItWorks.headlineLead, howItWorks.headlineAccent]}
          accent={[howItWorks.headlineAccent]}
        />
        <ol class="m-0 grid list-none grid-cols-1 gap-6 p-0 md:grid-cols-3">
          {
            howItWorks.steps.map((step) => (
              <li class="rounded-xl border border-gray-4 bg-white p-6">
                <h3 class="m-0 text-base font-semibold text-dark-blue-1">
                  {step.title}
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-gray-2">
                  {step.body}
                </p>
              </li>
            ))
          }
        </ol>
      </section>

      {
        [
          { data: pipelines, image: PipelinesShot },
          { data: driftDetection, image: DriftShot },
        ].map(({ data, image }) => (
          <section class="border-t border-gray-4 px-4 py-16 md:px-8">
            <SectionHeading
              eyebrow={data.eyebrow}
              words={[data.headlineLead, data.headlineAccent]}
              accent={[data.headlineAccent]}
            />
            <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-2">
              <FeatureList features={data.features} />
              <figure class="m-0">
                <Image
                  src={image}
                  alt={data.imageAlt}
                  loading="lazy"
                  class="w-full rounded-xl border border-gray-4"
                />
                <figcaption class="mt-3 text-xs text-gray-2">
                  {data.caption}
                </figcaption>
              </figure>
            </div>
          </section>
        ))
      }

      <section class="border-t border-gray-4 px-4 py-16 md:px-8">
        <SectionHeading
          eyebrow={patcher.eyebrow}
          words={[patcher.headlineLead, patcher.headlineAccent]}
          accent={[patcher.headlineAccent]}
        />
        <div class="max-w-[820px]">
          <FeatureList features={patcher.features} />
        </div>
      </section>

      <section
        id="view-plans"
        class="border-t border-gray-4 px-4 py-16 md:px-8"
      >
        <div class="mb-10 text-center">
          <h2
            class="m-0 text-3xl font-semibold tracking-[-0.01em] text-dark-blue-1 md:text-4xl"
          >
            <span class="text-accent-1">{pricing.headlineAccent}</span>{" "}
            {pricing.headline}
          </h2>
          <p class="mt-3 text-base text-gray-2">
            All plans include <strong class="font-semibold text-dark-blue-1"
              >{pricing.subheadEmphasis}</strong
            > runs and resources.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
          {
            pricing.plans.map((plan) => (
              <div class="flex flex-col rounded-2xl border border-gray-4 bg-white p-8">
                <p class="m-0 text-sm text-gray-2">{plan.priceLabel}</p>
                {plan.price && (
                  <p class="m-0 mt-1 text-4xl font-semibold text-dark-blue-1">
                    {plan.price}
                    {plan.priceFootnote && (
                      <sup class="ml-0.5 text-base text-gray-2">&dagger;</sup>
                    )}
                  </p>
                )}

                <h3 class="mt-6 text-xl font-semibold text-dark-blue-1">
                  {plan.name}
                </h3>
                <p class="m-0 mt-1 text-sm font-medium text-accent-1">
                  {plan.units}
                </p>
                <p class="m-0 mt-2 text-sm text-gray-2">{plan.audience}</p>

                {plan.upsell && (
                  <p class="m-0 mt-6 text-sm font-medium text-dark-blue-1">
                    {plan.upsell}
                  </p>
                )}

                <ul class="m-0 mt-6 flex list-none flex-col gap-3 p-0">
                  {plan.features.map((feature) => (
                    <li class="flex items-start gap-2.5 text-sm text-gray-7">
                      <svg
                        class="mt-0.5 size-4 shrink-0 text-accent-3"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M20 6 9 17l-5-5" />
                      </svg>
                      {feature}
                    </li>
                  ))}
                </ul>

                <div class="mt-auto pt-8">
                  {plan.footnote && (
                    <p class="m-0 mb-4 text-xs text-gray-2">
                      <sup>&dagger;</sup> {plan.footnote}
                    </p>
                  )}
                  <Button
                    href={plan.cta.href}
                    variant={plan.cta.variant}
                    size="lg"
                    class="w-full"
                  >
                    {plan.cta.label}
                  </Button>
                </div>
              </div>
            ))
          }
        </div>

        <p class="mt-8 text-center text-xs text-gray-2">
          {pricing.unitFootnote.before}
          <a
            href={pricing.unitFootnote.href}
            class="text-accent-1 underline underline-offset-2"
            rel="noopener noreferrer"
            target="_blank">{pricing.unitFootnote.linkLabel}</a
          >{pricing.unitFootnote.middle}<code
            class="rounded bg-gray-6 px-1 py-0.5 font-mono">{pricing.unitFootnote.code}</code
          >{pricing.unitFootnote.after}
        </p>
      </section>

      <section class="border-t border-gray-4 px-4 py-16 md:px-8">
        <figure class="mx-auto max-w-[820px] text-center">
          <blockquote class="m-0 text-xl leading-relaxed text-gray-7">
            &ldquo;{testimonial.quote}&rdquo;
          </blockquote>
          <figcaption class="mt-6">
            <span class="block font-semibold text-dark-blue-1"
              >{testimonial.name}</span
            >
            <span class="block text-sm text-gray-2">{testimonial.role}</span>
          </figcaption>
        </figure>
      </section>

      <section class="border-t border-gray-4 px-4 py-16 text-center md:px-8">
        <SectionHeading
          eyebrow={faqTeaser.eyebrow}
          words={[faqTeaser.headlineAccent, faqTeaser.headline]}
          accent={[faqTeaser.headlineAccent]}
        />
        <p class="m-0 text-base text-gray-2">
          Still have questions? Check out the <a
            href={faqTeaser.links.faq}
            class="text-accent-1 underline underline-offset-2">FAQ section</a
          > for answers or <a
            href={faqTeaser.links.contact}
            class="text-accent-1 underline underline-offset-2"
            >contact us directly</a
          >.
        </p>
      </section>

      <NewsletterSignup />
    </main>
  </div>

  <div class="mt-16">
    <OpenSourceTools />
    <Footer />
  </div>
</BaseLayout>
