---
import { Image } from "astro:assets";
import BaseLayout from "@layouts/BaseLayout.astro";
import Button from "@components/Button.astro";
import FeaturedBrands from "@components/FeaturedBrands.astro";
import Footer from "@components/Footer.astro";
import Nav from "@components/Nav.astro";
import NewsletterSignup from "@components/NewsletterSignup.astro";
import OpenSourceTools from "@components/OpenSourceTools.astro";
import SectionHeading from "@components/SectionHeading.astro";
import StaggeredSteps from "@components/StaggeredSteps.astro";
import SplitStack from "@components/SplitStack.astro";
import QuoteCard from "@components/QuoteCard.astro";
import BandPipelines from "@assets/icons/band-pipelines.svg";
import BandPatcher from "@assets/icons/band-patcher.svg";
import MediaFeatureBand from "@components/MediaFeatureBand.astro";
import VerticalGrid from "@components/VerticalGrid.astro";
import HeroCard from "@assets/img/tgs-hero-pr-card.png";
import Cube from "@assets/img/cube-3d.png";
import BoxesBg from "@assets/img/boxes-bg.svg";
import HeroBg from "@assets/img/hero-bg.png";
import PlanFree from "@assets/icons/plan-free.svg";
import PlanTeam from "@assets/icons/plan-team.svg";
import PlanEnterprise from "@assets/icons/plan-enterprise.svg";
import PurpleCheck from "@assets/icons/purple-check.svg";
import CaddiLogo from "@assets/img/caddi.webp";
import GithubMark from "@assets/icons/github-icon.svg";
import GitlabMark from "@assets/icons/gitlab-icon.svg";
import TerragruntMark from "@assets/icons/terragrunt-icon.svg";
import PipelinesShot from "@assets/img/tgs-pipelines-plan.png";
import DriftShot from "@assets/img/tgs-drift-detected.png";
import {
  driftDetection,
  faqTeaser,
  hero,
  howItWorks,
  patcher,
  pipelines,
  pricing,
  testimonial,
  video,
} from "@data/terragrunt-scale";

const title = "Terragrunt Scale | Secure GitOps Pipelines & Drift Detection";
const description =
  "Production-grade CI/CD for Terragrunt: plans in your pull requests, drift detection, and automatic module updates, running in your own CI runners.";

/*
 * The hero headline highlights three phrases. Splitting on them keeps the
 * sentence one string in the data file, rather than a list of fragments whose
 * spacing has to be reassembled correctly by whoever edits it next.
 */
/** `.built-for-pill` carries the product mark, as on the homepage and panel. */
const builtForMarks: Record<string, ImageMetadata> = {
  Github: GithubMark,
  Gitlab: GitlabMark,
  Terragrunt: TerragruntMark,
};

/** The 64px plan marks, keyed by plan name. */
const planMarks: Record<string, ImageMetadata> = {
  Free: PlanFree,
  Team: PlanTeam,
  Enterprise: PlanEnterprise,
};

const headlineParts = (() => {
  const pattern = new RegExp(`(${hero.accents.join("|")})`, "g");
  return hero.headline.split(pattern);
})();
---

<BaseLayout
  title={title}
  description={description}
  path="/terragrunt-scale"
>
  <VerticalGrid />
  <Nav active="/terragrunt-scale" />

  {/*
    `.terragrunt-scale-hero`: 589px of copy against the PR-card plate, which
    runs 80px past the right gutter. "Terragrunt Scale" is the HEADING and the
    long sentence is body copy beneath it — setting the whole sentence as an h1
    made the page open on a wall of display type the live page does not have,
    and the sentence's emphasis is white, not accent.
  */}
  <section class="relative z-[2] w-full overflow-hidden bg-bg-dark pt-[100px]">
    {/*
      `.terragrunt-scale-hero-inner` carries the boxes plate at 50%/200%, and
      the plate is most of the texture in the lower half of the band.
    */}
    <div
      class="mx-auto flex max-w-[1440px] flex-col gap-12 bg-[position:50%_200%] bg-[length:1440px] bg-no-repeat px-4 pb-20 md:px-20 lg:flex-row lg:items-start lg:justify-between lg:gap-[72px]"
      style={`background-image:url(${BoxesBg.src})`}
    >
      <div class="max-w-[589px] lg:pt-9">
        <h1
          class="m-0 text-4xl font-medium leading-[48px] text-white md:text-[60px]"
        >
          Terragrunt <span class="text-accent-4">Scale</span>
        </h1>

        <p class="mb-5 mt-10 text-lg leading-7 text-gray-1">
          {hero.headlineLead}{" "}
          {
            headlineParts.map((part) =>
              (hero.accents as readonly string[]).includes(part) ? (
                <span class="text-background">{part}</span>
              ) : (
                part
              ),
            )
          }
        </p>

        {/* `.terragrunt-scale-built-for` — 24px of clearance either side. */}
        <div class="flex flex-wrap items-center gap-y-2 py-6 font-mono text-xs uppercase leading-4 text-white">
          <span class="mr-8">{hero.builtForLabel}</span>
          {
            hero.builtFor.map((tool) => (
              <span class="mr-1 flex items-center gap-1.5 rounded border border-stroke-dark bg-bg-dark py-1 pl-1 pr-2.5 text-white">
                <Image
                  src={builtForMarks[tool]!}
                  alt=""
                  aria-hidden="true"
                  class="size-5 rounded-sm"
                />
                {tool}
              </span>
            ))
          }
        </div>

        <ul class="m-0 flex list-none flex-col p-0">
          {
            hero.assurances.map((item) => (
              <li class="my-[7px] flex items-center text-sm leading-[22px] text-accent-4">
                <Image
                  src={PurpleCheck}
                  alt=""
                  aria-hidden="true"
                  class="mr-2 size-[18px] shrink-0"
                />
                {item}
              </li>
            ))
          }
        </ul>

        <div class="mt-10 flex flex-wrap gap-5">
          <Button href={hero.primary.href} variant="primary" size="xl">
            {hero.primary.label}
          </Button>
          <Button href={hero.secondary.href} variant="secondary" size="xl">
            {hero.secondary.label}
          </Button>
        </div>
      </div>

      <Image
        src={HeroCard}
        alt="A Terragrunt plan posted as a pull request comment"
        loading="eager"
        class="hidden w-full max-w-[563px] shrink-0 rounded-lg lg:-mb-20 lg:block lg:self-end"
      />
    </div>
  </section>

  <div class="global-page-container">
    <main class="mx-auto w-full max-w-[1310px]">
      <FeaturedBrands />

      {/* `.video-container`: the caption sits inside the frame, under the
          player, not above it as a section rubric. */}
      <section class="mb-10 mt-[60px] px-6 md:px-8 lg:mb-[75px] lg:mt-[150px]">
        <figure
          class="mx-auto m-0 w-full max-w-[900px] rounded-xl border-[6px] border-[#e2e3e6] bg-background p-[18px]"
        >
          <div class="aspect-video w-full overflow-hidden rounded-md bg-bg-dark">
            <iframe
              src={`https://player.vimeo.com/video/${video.vimeoId}`}
              title={video.caption}
              class="size-full"
              loading="lazy"
              allow="fullscreen; picture-in-picture"
              allowfullscreen></iframe>
          </div>
          <figcaption class="mt-3.5 text-center text-sm text-gray-2">
            <strong class="font-semibold text-dark-blue-1">{video.duration}</strong>
            &nbsp;&bull;&nbsp;Watch a <code
              class="rounded bg-gray-6 px-1 py-0.5 font-mono text-[0.85em] text-accent-1"
              >terragrunt plan</code
            > run in response to a pull request
          </figcaption>
        </figure>
      </section>

      <StaggeredSteps
        icon={BandPipelines}
        eyebrow={howItWorks.eyebrow}
        headlineAccent={howItWorks.headlineLead}
        headline={howItWorks.headlineAccent}
        steps={howItWorks.steps}
      />

      {
        [
          { data: pipelines, image: PipelinesShot },
          { data: driftDetection, image: DriftShot, reverse: true },
        ].map(({ data, image, reverse }) => (
          <MediaFeatureBand
            reverse={reverse}
            eyebrow={data.eyebrow}
            headlineLead={data.headlineLead}
            headlineAccent={data.headlineAccent}
            features={data.features}
            image={image}
            imageAlt={data.imageAlt}
            caption={data.caption}
          />
        ))
      }

      <SplitStack
        icon={BandPatcher}
        eyebrow={patcher.eyebrow}
        lead={patcher.headlineLead}
        headline={patcher.headlineAccent}
        features={patcher.features}
      />

      <section
        id="view-plans"
        class="border-t border-gray-4 px-6 py-6 lg:py-[76px] md:px-8"
      >
        {/*
          `.terragrunt-scale-pricing-inner`: the hero plate washed across the
          bottom of a 6px --gray-5 frame, 80px of padding at the top and 100px
          at the foot. Each card leads with its 64px plan mark and the price on
          the same row, not with a label above a number.
        */}
        <div
          class="relative mx-6 overflow-hidden rounded-3xl border-[6px] border-gray-5 bg-bg-dark bg-[position:0_100%] bg-[length:150%] bg-no-repeat px-6 pb-[100px] pt-20 md:px-12"
          style={`background-image:url(${HeroBg.src})`}
        >
        <div class="mx-auto flex max-w-[850px] flex-col items-center gap-8 text-center">
          <h2
            class="m-0 text-[32px] font-medium leading-[1.5em] text-white md:text-[42px]"
          >
            <span class="text-accent-4">{pricing.headlineAccent}</span>{" "}
            {pricing.headline}
          </h2>
          <p class="m-0 text-base leading-6 text-gray-1">
            All plans include <strong class="font-bold"
              >{pricing.subheadEmphasis}</strong
            > runs and resources.
          </p>
        </div>

        <Image
          src={Cube}
          alt=""
          aria-hidden="true"
          loading="lazy"
          class="pointer-events-none absolute left-[162px] top-[159px] hidden w-[130px] lg:block"
        />

        <div class="grid grid-cols-1 items-stretch gap-12 pt-[60px] lg:grid-cols-3">
          {
            pricing.plans.map((plan) => (
              <div class="relative flex h-full max-w-[400px] flex-col rounded-lg border border-[#2f3547] bg-bg-dark bg-gradient-to-b from-[#5862aa24] to-[#5862aa00] to-60% p-6">
                <div class="mb-6 flex items-center justify-between gap-4">
                  <Image
                    src={planMarks[plan.name]!}
                    alt=""
                    aria-hidden="true"
                    loading="lazy"
                    class="size-16 shrink-0"
                  />
                  <div class="text-right">
                    <p class="m-0 font-mono text-[11px] uppercase leading-4 tracking-[0.06em] text-gray-1">
                      {plan.priceLabel}
                    </p>
                    <p class="m-0 text-[32px] leading-[44px] text-gray-1">
                      {plan.price}
                      {plan.priceFootnote && (
                        <sup class="ml-0.5 align-super text-sm">&dagger;</sup>
                      )}
                    </p>
                  </div>
                </div>

                <h3 class="m-0 text-xl font-normal leading-5 text-white">
                  {plan.name}
                </h3>
                <p class="m-0 mt-2 text-sm leading-5 text-accent-4">
                  {plan.units}
                </p>
                <p class="m-0 mt-2 text-sm leading-5 text-gray-1">
                  {plan.audience}
                </p>

                {plan.upsell && (
                  <p class="m-0 mt-2 text-sm leading-5 text-white">
                    {plan.upsell}
                  </p>
                )}

                <ul class="m-0 mt-6 flex list-none flex-col p-0">
                  {plan.features.map((feature) => (
                    <li class="my-[11px] flex items-center text-sm leading-[22px] text-gray-1">
                      <Image
                        src={PurpleCheck}
                        alt=""
                        aria-hidden="true"
                        loading="lazy"
                        class="mr-2 size-[18px] shrink-0"
                      />
                      {feature}
                    </li>
                  ))}
                </ul>

                <div class="mt-auto flex items-center py-6">
                  {plan.footnote && (
                    <p class="m-0 text-sm leading-5 text-gray-1">
                      <sup>&dagger;</sup> {plan.footnote}
                    </p>
                  )}
                </div>
                <Button
                  href={plan.cta.href}
                  variant={plan.cta.variant}
                  class="w-full"
                >
                  {plan.cta.label}
                </Button>
              </div>
            ))
          }
        </div>

        </div>
        <p class="mt-8 text-center text-xs text-gray-2">
          {pricing.unitFootnote.before}
          <a
            href={pricing.unitFootnote.href}
            class="text-accent-1 underline underline-offset-2"
            rel="noopener noreferrer"
            target="_blank">{pricing.unitFootnote.linkLabel}</a
          >{pricing.unitFootnote.middle}<code
            class="rounded bg-gray-6 px-1 py-0.5 font-mono">{pricing.unitFootnote.code}</code
          >{pricing.unitFootnote.after}
        </p>
      </section>

      <QuoteCard
        quote={testimonial.quote}
        name={testimonial.name}
        role={testimonial.role}
        logo={CaddiLogo}
        logoAlt="Logo for Caddi"
      />

      {/* `.faq-inner`: 850px, left aligned, 24px in — not a centred coda. */}
      <section class="px-6 py-6 lg:py-[76px] md:px-8">
        <div class="mx-auto max-w-[850px] pl-6">
          <SectionHeading
            eyebrow={faqTeaser.eyebrow}
            words={[faqTeaser.headlineAccent, faqTeaser.headline]}
            accent={[faqTeaser.headlineAccent]}
            leading="loose"
          />
          <p class="m-0 mt-[60px] text-sm leading-5 text-gray-1">
            Still have questions? Check out the <a
              href={faqTeaser.links.faq}
              class="text-accent-1 underline underline-offset-2">FAQ section</a
            > for answers or <a
              href={faqTeaser.links.contact}
              class="text-accent-1 underline underline-offset-2"
              >contact us directly</a
            >.
          </p>
        </div>
      </section>

      <NewsletterSignup />
    </main>
  </div>

  <div class="mt-16">
    <OpenSourceTools />
    <Footer gradient={false} />
  </div>
</BaseLayout>
