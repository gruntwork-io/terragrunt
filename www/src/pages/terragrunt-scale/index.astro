---
import { Image } from "astro:assets";
import BaseLayout from "@layouts/BaseLayout.astro";
import Button from "@components/Button.astro";
import FeaturedBrands from "@components/FeaturedBrands.astro";
import Footer from "@components/Footer.astro";
import Nav from "@components/Nav.astro";
import NewsletterSignup from "@components/NewsletterSignup.astro";
import OpenSourceTools from "@components/OpenSourceTools.astro";
import SectionHeading from "@components/SectionHeading.astro";
import { renderLede } from "@lib/lede";
import StaggeredSteps from "@components/StaggeredSteps.astro";
import MediaFeatureBand from "@components/MediaFeatureBand.astro";
import VerticalGrid from "@components/VerticalGrid.astro";
import HeroCard from "@assets/img/tgs-hero-pr-card.png";
import Cube from "@assets/img/cube-3d.png";
import PipelinesShot from "@assets/img/tgs-pipelines-plan.png";
import DriftShot from "@assets/img/tgs-drift-detected.png";
import {
  driftDetection,
  faqTeaser,
  hero,
  howItWorks,
  patcher,
  pipelines,
  pricing,
  testimonial,
  video,
} from "@data/terragrunt-scale";

const title = "Terragrunt Scale | Secure GitOps Pipelines & Drift Detection";
const description =
  "Production-grade CI/CD for Terragrunt: plans in your pull requests, drift detection, and automatic module updates, running in your own CI runners.";

/*
 * The hero headline highlights three phrases. Splitting on them keeps the
 * sentence one string in the data file, rather than a list of fragments whose
 * spacing has to be reassembled correctly by whoever edits it next.
 */
const headlineParts = (() => {
  const pattern = new RegExp(`(${hero.accents.join("|")})`, "g");
  return hero.headline.split(pattern);
})();
---

<BaseLayout
  title={title}
  description={description}
  path="/terragrunt-scale"
>
  <VerticalGrid />
  <Nav active="/terragrunt-scale" />

  {/*
    Two columns: copy left, the product screenshot right. "Terragrunt Scale" is
    the HEADING and the long sentence is body copy beneath it — setting the
    whole sentence as an h1 made the page open on a wall of display type that
    the live page does not have.
  */}
  <section class="relative z-[2] w-full overflow-hidden bg-bg-dark pt-[100px]">
    <div class="mx-auto grid max-w-[1310px] grid-cols-1 gap-12 px-4 pb-[76px] md:px-8 lg:grid-cols-2 lg:items-start">
      <div>
        <h1
          class="m-0 text-4xl font-semibold leading-[1.05] tracking-[-0.02em] text-white md:text-6xl"
        >
          Terragrunt <span class="text-accent-4">Scale</span>
        </h1>

        <p class="mt-5 max-w-[46ch] text-base leading-relaxed text-gray-1">
          {hero.headlineLead}{" "}
          {
            headlineParts.map((part) =>
              (hero.accents as readonly string[]).includes(part) ? (
                <span class="font-medium text-white">{part}</span>
              ) : (
                part
              ),
            )
          }
        </p>

        <p class="mt-8 flex flex-wrap items-center gap-2">
          <span
            class="font-mono text-[11px] uppercase tracking-[0.08em] text-gray-1"
            >{hero.builtForLabel}</span
          >
          {
            hero.builtFor.map((tool) => (
              <span class="rounded-full bg-background px-3 py-1 text-xs font-medium text-bg-dark">
                {tool}
              </span>
            ))
          }
        </p>

        <ul class="m-0 mt-6 flex list-none flex-col gap-2 p-0">
          {
            hero.assurances.map((item) => (
              <li class="flex items-center gap-2.5 text-sm text-gray-1">
                <svg
                  class="size-4 shrink-0 text-accent-3"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M20 6 9 17l-5-5" />
                </svg>
                {item}
              </li>
            ))
          }
        </ul>

        <div class="mt-8 flex flex-wrap gap-3">
          <Button href={hero.primary.href} variant="primary" size="lg">
            {hero.primary.label}
          </Button>
          <Button href={hero.secondary.href} variant="secondary" size="lg">
            {hero.secondary.label}
          </Button>
        </div>
      </div>

      <div class="relative">
        <Image
          src={Cube}
          alt=""
          aria-hidden="true"
          class="absolute -top-10 left-0 w-16 lg:-left-6"
        />
        <Image
          src={HeroCard}
          alt="A Terragrunt plan posted as a pull request comment"
          loading="eager"
          class="w-full rounded-lg"
        />
      </div>
    </div>
  </section>

  <div class="global-page-container">
    <main class="mx-auto w-full max-w-[1310px]">
      <FeaturedBrands />

      <section class="mb-[75px] mt-[150px] px-4 md:px-8">
        <p class="m-0 mb-4 text-center text-sm text-gray-2">
          <strong class="font-semibold text-dark-blue-1">{video.duration}</strong>
          &nbsp;&bull;&nbsp;Watch a <code
            class="rounded bg-gray-6 px-1 py-0.5 font-mono text-[0.85em] text-accent-1"
            >terragrunt plan</code
          > run in response to a pull request
        </p>
        <div
          class="mx-auto w-full max-w-[900px] rounded-xl border-[6px] border-[#e2e3e6] bg-background p-[18px]"
        >
          <div class="aspect-video w-full overflow-hidden rounded-md bg-bg-dark">
          <iframe
            src={`https://player.vimeo.com/video/${video.vimeoId}`}
            title={video.caption}
            class="size-full"
            loading="lazy"
            allow="fullscreen; picture-in-picture"
            allowfullscreen></iframe>
          </div>
        </div>
      </section>

      <StaggeredSteps
        eyebrow={howItWorks.eyebrow}
        headlineAccent={howItWorks.headlineLead}
        headline={howItWorks.headlineAccent}
        steps={howItWorks.steps}
      />

      {
        [
          { data: pipelines, image: PipelinesShot },
          { data: driftDetection, image: DriftShot, reverse: true },
        ].map(({ data, image, reverse }) => (
          <MediaFeatureBand
            reverse={reverse}
            eyebrow={data.eyebrow}
            headlineLead={data.headlineLead}
            headlineAccent={data.headlineAccent}
            features={data.features}
            image={image}
            imageAlt={data.imageAlt}
            caption={data.caption}
          />
        ))
      }

      <section class="px-4 py-[76px] md:px-8">
        <div class="mx-auto grid max-w-[960px] grid-cols-1 gap-8 lg:grid-cols-2">
          <div>
            <span class="mb-8 inline-block bg-accent-background px-2 py-0.5 font-mono text-[11px] font-medium uppercase tracking-[0.06em] text-accent-1">
              {patcher.eyebrow}
            </span>
            <h2 class="m-0 max-w-[340px] text-[2rem] font-medium leading-[1.15] tracking-[-0.02em] text-dark-blue-1 md:text-[42px] md:leading-[46.67px]">
              <span class="text-accent-1">{patcher.headlineLead}</span>{" "}{patcher.headlineAccent}
            </h2>
          </div>
          <div class="flex flex-col">
            {
              patcher.features.map((feature, i) => (
                <div
                  class:list={[
                    "flex flex-col gap-4 py-6",
                    i > 0 && "border-t border-dashed border-gray-4",
                  ]}
                >
                  <h3 class="m-0 text-base font-semibold text-dark-blue-1">
                    {feature.title}
                  </h3>
                  <div
                    class="text-sm leading-relaxed text-gray-2 [&_code]:rounded [&_code]:bg-gray-6 [&_code]:px-1 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-[0.85em] [&_code]:text-accent-1 [&_p]:m-0"
                    set:html={renderLede(feature.body)}
                  />
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section
        id="view-plans"
        class="border-t border-gray-4 px-4 py-[76px] md:px-8"
      >
        <div class="relative overflow-hidden rounded-3xl border-[6px] border-gray-5 bg-bg-dark px-6 py-20 md:px-12">
        <Image
          src={Cube}
          alt=""
          aria-hidden="true"
          loading="lazy"
          class="pointer-events-none absolute left-10 top-16 hidden w-24 lg:block"
        />
        <div class="mb-10 text-center">
          <h2
            class="m-0 text-[32px] font-medium leading-[1.5em] text-white md:text-[42px]"
          >
            <span class="text-accent-1">{pricing.headlineAccent}</span>{" "}
            {pricing.headline}
          </h2>
          <p class="mt-3 text-base text-gray-1">
            All plans include <strong class="font-semibold text-white"
              >{pricing.subheadEmphasis}</strong
            > runs and resources.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-12 lg:grid-cols-3">
          {
            pricing.plans.map((plan) => (
              <div class="flex max-w-[400px] flex-col rounded-lg border border-[#2f3547] bg-bg-dark bg-gradient-to-b from-[#5862aa24] to-[#5862aa00] to-60% p-6">
                <p class="m-0 text-sm text-gray-1">{plan.priceLabel}</p>
                {plan.price && (
                  <p class="m-0 mt-1 text-4xl font-semibold text-white">
                    {plan.price}
                    {plan.priceFootnote && (
                      <sup class="ml-0.5 text-base text-gray-1">&dagger;</sup>
                    )}
                  </p>
                )}

                <h3 class="mt-6 text-xl font-semibold text-white">
                  {plan.name}
                </h3>
                <p class="m-0 mt-1 text-sm font-medium text-accent-4">
                  {plan.units}
                </p>
                <p class="m-0 mt-2 text-sm text-gray-1">{plan.audience}</p>

                {plan.upsell && (
                  <p class="m-0 mt-6 text-sm font-medium text-white">
                    {plan.upsell}
                  </p>
                )}

                <ul class="m-0 mt-6 flex list-none flex-col gap-3 p-0">
                  {plan.features.map((feature) => (
                    <li class="flex items-start gap-2.5 text-sm text-gray-1">
                      <svg
                        class="mt-0.5 size-4 shrink-0 text-accent-3"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M20 6 9 17l-5-5" />
                      </svg>
                      {feature}
                    </li>
                  ))}
                </ul>

                <div class="mt-auto pt-8">
                  {plan.footnote && (
                    <p class="m-0 mb-4 text-xs text-gray-1">
                      <sup>&dagger;</sup> {plan.footnote}
                    </p>
                  )}
                  <Button
                    href={plan.cta.href}
                    variant={plan.cta.variant}
                    size="lg"
                    class="w-full"
                  >
                    {plan.cta.label}
                  </Button>
                </div>
              </div>
            ))
          }
        </div>

        </div>
        <p class="mt-8 text-center text-xs text-gray-2">
          {pricing.unitFootnote.before}
          <a
            href={pricing.unitFootnote.href}
            class="text-accent-1 underline underline-offset-2"
            rel="noopener noreferrer"
            target="_blank">{pricing.unitFootnote.linkLabel}</a
          >{pricing.unitFootnote.middle}<code
            class="rounded bg-gray-6 px-1 py-0.5 font-mono">{pricing.unitFootnote.code}</code
          >{pricing.unitFootnote.after}
        </p>
      </section>

      <section class="border-t border-gray-4 px-4 py-[76px] md:px-8">
        <figure class="mx-auto max-w-[820px] text-center">
          <blockquote class="m-0 text-xl leading-relaxed text-gray-7">
            &ldquo;{testimonial.quote}&rdquo;
          </blockquote>
          <figcaption class="mt-6">
            <span class="block font-semibold text-dark-blue-1"
              >{testimonial.name}</span
            >
            <span class="block text-sm text-gray-2">{testimonial.role}</span>
          </figcaption>
        </figure>
      </section>

      <section class="border-t border-gray-4 px-4 py-16 text-center md:px-8">
        <SectionHeading
          eyebrow={faqTeaser.eyebrow}
          words={[faqTeaser.headlineAccent, faqTeaser.headline]}
          accent={[faqTeaser.headlineAccent]}
        />
        <p class="m-0 text-base text-gray-2">
          Still have questions? Check out the <a
            href={faqTeaser.links.faq}
            class="text-accent-1 underline underline-offset-2">FAQ section</a
          > for answers or <a
            href={faqTeaser.links.contact}
            class="text-accent-1 underline underline-offset-2"
            >contact us directly</a
          >.
        </p>
      </section>

      <NewsletterSignup />
    </main>
  </div>

  <div class="mt-16">
    <OpenSourceTools />
    <Footer />
  </div>
</BaseLayout>
